# ==============================================================================
# DOKKANY STORE (dokkany.shop) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL - Neon / Supabase)
DATABASE_URL="postgresql://dokkany_user:password@ep-cool-db.eu-central-1.aws.neon.tech/dokkany?sslmode=require"
DIRECT_URL="postgresql://dokkany_user:password@ep-cool-db.eu-central-1.aws.neon.tech/dokkany?sslmode=require"

# Application URLs
APP_URL="https://dokkany.shop"
NEXT_PUBLIC_APP_URL="https://dokkany.shop"

# WhatsApp Business / Sales Channel
# الصيغة الدولية بدون علامة + (مثال لرقم مصري: 201012345678)
NEXT_PUBLIC_WHATSAPP_PHONE="201099887766"
NEXT_PUBLIC_WHATSAPP_DISPLAY="01099887766"

# Meta WhatsApp Cloud API (لإشعارات السيرفر الآلية - اختياري)
WHATSAPP_CLOUD_API_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="109876543210987"
WHATSAPP_BUSINESS_ACCOUNT_ID="123456789012345"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="dokkany_secure_token_2026"

# Telegram Bot (بديل مجاني 100% لإشعار صاحب المتجر فور وصول أي طلب جديد)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="987654321"

# Security & Admin Authentication
ADMIN_JWT_SECRET="generate-a-strong-random-64-character-secret-key-here"
ADMIN_DEFAULT_EMAIL="admin@dokkany.shop"
ADMIN_DEFAULT_PASSWORD="ChangeThisPassword123!"

# Cloudinary / Supabase Storage (لرفع صور المنتجات)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dokkany"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="abcdefghijk12345"

# Upstash Redis (Rate limiting وحماية الطلبات الوهمية)
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXXX..."
